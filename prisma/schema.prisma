datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generator — gera o Prisma Client em JavaScript
generator client {
  provider = "prisma-client-js"
}

// Enum — valores fixos para o campo role
enum Role {
  USER
  ADMIN
}

// Model Servico — serviço oferecido pela Standart Contabilidade
model Servico {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String
  imagemUrl   String?
  autorId     Int
  autor       Usuario  @relation("ServicosCriados", fields: [autorId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Model Funcionario — equipe exibida pela contabilidade
model Funcionario {
  id          Int      @id @default(autoincrement())
  nome        String
  cargo       String
  email       String?
  telefone    String?
  fotoUrl     String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Model Usuario — autenticação e autorização da aplicação
model Usuario {
  id            Int        @id @default(autoincrement())
  nome          String
  email         String     @unique
  usuario       String?    @unique
  senhaHash     String
  cidade        String?
  frase         String?
  planosFuturos String?
  fotoUrl       String?
  role          Role       @default(USER)
  criadoEm      DateTime   @default(now())
  servicos      Servico[]  @relation("ServicosCriados")
}
